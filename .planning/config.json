{
  "mode": "interactive",
  "depth": "standard",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "balanced",
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true
  },
  "nexus": {
    "enabled": true,
    "repo": "Mail_Watcher",
    "required_in": ["research", "execution"],
    "rules": {
      "impact_before_edit": true,
      "detect_changes_before_commit": true,
      "use_rename_tool": true,
      "query_before_grep": true
    }
  },
  "autopilot": {
    "checkpoint_mode": "queue",
    "max_retries": 3,
    "budget_limit_usd": 0,
    "notify_webhook": "",
    "model": "default"
  }
}
